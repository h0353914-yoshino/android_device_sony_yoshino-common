# Allow hal_power_default to read power stats
r_dir_file(hal_power_default, debugfs_wlan)

# Allow hal_power_default to write to cpu_dma_latency
allow hal_power_default device_latency:chr_file rw_file_perms;

# Allow hal_power_default to tune the bus-DCVS devfreq node
allow hal_power_default sysfs_cpubw:dir r_dir_perms;
allow hal_power_default sysfs_cpubw:file rw_file_perms;
