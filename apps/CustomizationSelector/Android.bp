// 經 /dev/diag 讀寫 modem EFS 的 JNI 函式庫（不相容的 modem 設定改寫 EFS 檔案時使用）
cc_library_shared {
    name: "libdiagefs",
    srcs: ["jni/diagefs.c"],
    system_ext_specific: true,
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
    ],
}

android_app {
    name: "CustomizationSelector",

    srcs: [
        "src/**/*.java",
        "src-misc-ta/**/*.java"
    ],

    resource_dirs: ["res"],
    asset_dirs: ["assets"],

    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    enforce_uses_libs: false,

    jni_libs: ["libdiagefs"],

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
        "com.google.android.material_material"
    ],
}
