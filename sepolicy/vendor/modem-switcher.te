type modem-switcher, domain;
type modem-switcher_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(modem-switcher)

# Allow access to the HALs
hal_client_domain(modem-switcher, hal_allocator)

# Allow modem-switcher, to use hw-binder service
hwbinder_use(modem-switcher)

# Allow binder communication with hal_miscta_default
binder_call(modem-switcher, hal_miscta_default)

# Allow modem-switcher to find hal_miscta_default
allow modem-switcher hal_miscta_hwservice:hwservice_manager find;

# Allow modem-switcher to find hidl_memory
allow modem-switcher hidl_memory_hwservice:hwservice_manager find;

# Allow modem-switcher to read/write in /data/vendor/
allow modem-switcher vendor_data_file:dir rw_dir_perms;
allow modem-switcher vendor_data_file:file create_file_perms;

# Allow modem-switcher to search /dev/block/by-name
allow modem-switcher block_device:dir r_dir_perms;

# Allow modem-switcher to write the fsg and modemst partitions
allow modem-switcher modem_efs_partition_device:blk_file { open read write getattr ioctl };

# Label the status and report files in /data/vendor as modemsw_data_file
type_transition modem-switcher vendor_data_file:file modemsw_data_file "modem_switcher_report";
type_transition modem-switcher vendor_data_file:file modemsw_data_file "modem_switcher_status";
allow modem-switcher modemsw_data_file:file create_file_perms;

# Allow modem-switcher to chown the files it creates in /data/vendor
allow modem-switcher self:capability chown;
