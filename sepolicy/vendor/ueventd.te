typeattribute ueventd data_between_core_and_vendor_violators;

# Allow ueventd to read files in wifi_vendor_data_file
r_dir_file(ueventd, wifi_vendor_data_file)

# Allow ueventd to read the debugfs root directory
allow ueventd debugfs:dir r_dir_perms;

# Allow ueventd to getattr debugfs files it walks at boot
allow ueventd debugfs:file getattr;

# Allow ueventd to getattr the debugfs wakeup_sources node
allow ueventd debugfs_wakeup_sources:file getattr;
